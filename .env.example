# ── Phase 5: Supabase ─────────────────────────────────────────────────────────
# Create the project at https://supabase.com → Project Settings → API,
# then copy the values into .env.local (this file must stay secret-free).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER import into client code, never expose to the browser.
# Used only by server-side admin/seed tooling.
SUPABASE_SERVICE_ROLE_KEY=

# ── SMS provider (MSG91 via Supabase Send SMS Hook) ───────────────────────────
# Consumed by the Auth "Send SMS" hook (Supabase Edge Function), NOT by Next.js.
# Set with: supabase secrets set MSG91_AUTH_KEY=... MSG91_SENDER_ID=... MSG91_DLT_TEMPLATE_ID=...
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# ── Public site URL ───────────────────────────────────────────────────────────
# Vercel production domain once deployed (https://<project>.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analytics (wired dormant — activation deferred, D7) ───────────────────────
NEXT_PUBLIC_GTM_ID=
